# ──────────────── MySQL 접속정보 ────────────────
DB_HOST = mysql
DB_PORT = 3306
DB_NAME = secondary_battery_db
DB_USER = root2
DB_PW   = projectteam2@

# 루트 계정은 초기화 용도에만 사용
MYSQL_ROOT_PASSWORD = projectteam2@@
MYSQL_DATABASE      = ${DB_NAME}
MYSQL_USER          = ${DB_USER}
MYSQL_PASSWORD      = ${DB_PW}

# ──────────────── OPC UA 설정 ────────────────
UA_ENDPOINT  = opc.tcp://opcua-server:4840/inspect/server/
UA_NAMESPACE = http://inspect.system

# ──────────────── Vision 센서 주기 ────────────────
V1_INTERVAL = 2
V2_INTERVAL = 2

# ──────────────── PLC 설정 ────────────────
PLC_IP          = 192.168.3.30
PLC_PORT        = 5000
PLC_DEVICE      = D200
VOLT_SCALE      = 0.01
VOLT_LOW_LIMIT  = 3.70
VOLT_HIGH_LIMIT = 4.20
VOLT_POLL_CYCLE = 1.0