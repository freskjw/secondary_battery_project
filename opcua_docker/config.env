# ──────────────── MySQL 접속정보 ────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=secondary_battery_db
DB_USER=root2
DB_PW=projectteam2@

MYSQL_ROOT_PASSWORD=projectteam2@@
MYSQL_DATABASE=secondary_battery_db
MYSQL_USER=root2
MYSQL_PASSWORD=projectteam2@

# ──────────────── OPC UA 설정 ────────────────
UA_LISTEN_ENDPOINT=opc.tcp://0.0.0.0:4840/inspect/server/
UA_ENDPOINT=opc.tcp://opcua-server:4840/inspect/server/
UA_NAMESPACE=http://inspect.system

# ──────────────── Vision 센서 주기 ────────────────
V1_INTERVAL=2.0
V2_INTERVAL=2.0

# ──────────────── PLC 설정 ────────────────
PLC_IP=192.168.3.30
PLC_PORT=6001
PLC_DEVICE=D100
VOLT_SCALE=0.01
VOLT_LOW_LIMIT=3.80
VOLT_HIGH_LIMIT=4.10
VOLT_POLL_CYCLE=1.0

# ──────────────── DB ────────────────
LINE_ID=1        # 라인 식별자 (Writer / Bridge / Calculator 공통)


# --------------------시뮬레이션 설정 ------------------

USE_SIMULATION=false     # or false