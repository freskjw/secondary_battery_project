# ── (선택) AI Reporter 주기/기간 ────────────────────────────────────────────
# 매일 RUN_AT에 실행. REPORT_PERIODS 미설정 시: 항상 D(일간), 월요일엔 W(지난주), 매월 1일엔 M(지난달) 자동 생성
REPORT_RUN_AT=08:15
REPORT_PERIODS=           # 예: D,W,M  (비우면 자동 규칙 사용)

# Reporter 전용 DB (더미)
REPORT_DB_HOST=mysql
REPORT_DB_PORT=3306
REPORT_DB_USER=root
