# MySQL 데이터베이스 설정

DB_HOST         = localhost             # DB 서버 주소(OR IP)
DB_PORT         = 3306                  # 포트(기본 3306)
DB_USER         = root                  # 접속 계정
DB_PW           = projectteam2@@        # 비밀번호
DB_NAME         = secondary_battery_db  # 사용할 DB 이름

# OPC UA 서버(허브) 설정

UA_ENDPOINT = opc.tcp://localhost:4840/inspect/server/
# 모든 워커(Vision1/2, Voltage, OPCUA_To_DB)가 접속할 UA 엔드포인트
# 서버, 클라이언트가 다른 PC라면 IP부분을 수정

# PLC (MC-Protocol) 전압 검사 설정

PLC_IP          = 192.168.3.30  # PLC Ethernet 모듈 IP
PLC_PORT        = 5000          # SLMP 통신 포트(기본값 5000)
PLC_DEVICE      = D200          # 전압값이 저장된 WORD 주소
VOLT_SCALE      = 0.01          # WORD x 계수 -> 실전압(V)
VOLT_LOW        = 3.70          # 전압 OK 하한(V)
VOLT_HIGH       = 4.20          # 전압 OK 상한(V)